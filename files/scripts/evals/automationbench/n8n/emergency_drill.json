    {
      "id": "2",
      "name": "Find Safety Emails",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        320,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "__AUTOMATIONBENCH_BRIDGE_URL__/invoke",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-AutomationBench-Token",
              "value": "__AUTOMATIONBENCH_BRIDGE_TOKEN__"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ tool: \"gmail_find_email\", args: {query:'from:safety@company.example.com'} }) }}",
        "options": {}
      }
    },
    {
      "id": "3",
      "name": "Parse Latest HQ Notice",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        540,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const envelope = $input.first().json;\nif (!envelope.ok) throw new Error('Gmail tool failed: '+JSON.stringify(envelope));\nconst data = typeof envelope.result === 'string' ? JSON.parse(envelope.result) : envelope.result;\nconst messages = (data.messages ?? []).filter(m => m.subject?.startsWith('Emergency Drill - HQ'));\nmessages.sort((a,b) => Number(b.internal_date ?? b.date ?? 0) - Number(a.internal_date ?? a.date ?? 0));\nif (!messages.length) throw new Error('No HQ drill safety notice');\nconst latest = messages[0];\nconst text = latest.body_plain ?? '';\nconst times = text.match(/(\\d{4}-\\d{2}-\\d{2})\\s+(\\d{2}:\\d{2})-(\\d{2}:\\d{2})\\s*UTC/);\nif (!times) throw new Error('Newest HQ notice contains no schedule: '+text);\nconst [, date, start, end] = times;\nreturn [{json:{notice:text, subject:latest.subject, date, start, end,\n  afterHours:Number(start.slice(0,2)) >= 17}}];"
      }
    },
    {
      "id": "4",
      "name": "Find Monday Item",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        760,
        300
