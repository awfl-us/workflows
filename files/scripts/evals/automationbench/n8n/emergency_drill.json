        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ tool: \"monday_find_item\", args: {board_id:'brd_ops',name:'HQ Emergency Drill'} }) }}",
        "options": {}
      }
    },
    {
      "id": "5",
      "name": "Read Monday Item",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        980,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const envelope = $input.first().json;\nif (!envelope.ok) throw new Error('Monday search failed: '+JSON.stringify(envelope));\nconst data = typeof envelope.result === 'string' ? JSON.parse(envelope.result) : envelope.result;\nconst itemId = data.results?.[0]?.item_id;\nif (!itemId) throw new Error('HQ drill item not found on brd_ops');\nreturn [{json:{itemId}}];"
      }
    },
